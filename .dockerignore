Apply
# Ignore all files and directories by default
*

# Do not ignore .py files (to include Python source code)
!*.py

# Include "server" directory
!server/

# Include "scripts" directory
!scripts/

# Include "static" directory
!static/
static/assets
static/favicon.ico
static/favicon.png
static/index.html
static/logo192.png
static/logo512.png
static/manifest.json
static/robots.txt

# The DeepFellow Dashboard, from webui2/, emits a different set of names than the legacy UI.
# Without these, a stray dashboard build left in static/ would enter the build context of a LEGACY image.
static/apple-touch-icon.png
static/favicon.svg
static/icon-192.png
static/icon-512.png
static/manifest.webmanifest
static/runtimeInjectedEnv.json
static/tray-icon.png
static/tray-icon@2x.png

# Do not match pyproject.* files
!pyproject.toml

# Include specific pyproject files
!uv.lock

# Include license
LICENSE.md

!webui/
webui/dist
webui/node_modules

!webui2/
webui2/dist
webui2/node_modules
