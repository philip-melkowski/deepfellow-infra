# Copy to tests/smoke/.env and fill in real values.
# Bruno reads this file automatically and exposes vars via {{process.env.X}}.
# The .env file is git-ignored — never commit real secrets.

# Infra API key (DF_INFRA_API_KEY on the target server) — used for /v1/* and /info.
API_TOKEN=

# Admin API key (DF_INFRA_ADMIN_API_KEY) — used for /admin/* endpoints.
ADMIN_TOKEN=

# Version string /info is expected to report, without the leading "v"
# (e.g. 0.31.0). Leave empty to skip the version assertion; CI sets it from the
# release tag so the smoke run proves the deployed build is the tagged one.
EXPECTED_VERSION=
