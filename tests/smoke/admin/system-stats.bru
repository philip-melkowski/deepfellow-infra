meta {
  name: System Stats
  type: http
  seq: 5
}

get {
  url: {{host}}/admin/settings/hardware/system-stats
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.ADMIN_TOKEN}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("reports cpu and ram", function() {
    expect(res.getBody().cpu_percent).to.be.a("number");
    expect(res.getBody().ram_total_gb).to.be.a("number");
  });
}
