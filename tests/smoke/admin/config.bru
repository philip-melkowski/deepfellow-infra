meta {
  name: List Config Entries
  type: http
  seq: 4
}

get {
  url: {{host}}/admin/config
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.ADMIN_TOKEN}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("entries is an array", function() {
    expect(res.getBody().entries).to.be.an("array");
  });
}
