meta {
  name: Mesh Info
  type: http
  seq: 7
}

get {
  url: {{host}}/admin/mesh/info
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.ADMIN_TOKEN}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("has connections list", function() {
    expect(res.getBody().info.connections).to.be.an("array");
  });
}
