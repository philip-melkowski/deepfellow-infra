meta {
  name: List All Models (admin)
  type: http
  seq: 3
}

get {
  url: {{host}}/admin/services/models
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.ADMIN_TOKEN}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  // /models is declared before /{service_id} in server/api/services.py, so it
  // resolves to the aggregate route rather than being read as a service id.
  test("list is an array", function() {
    expect(res.getBody().list).to.be.an("array");
  });
}
